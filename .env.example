# Optional AI provider configuration.
# Without these, the chat uses Pollinations' keyless endpoint, which is limited
# to one free reply every 30 seconds per IP.

# Free Groq key: https://console.groq.com/keys
# GROQ_API_KEY=

# Free Google AI Studio key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# Or any OpenAI-compatible endpoint:
# AI_BASE_URL=https://api.example.com/v1/chat/completions
# AI_API_KEY=
# AI_MODEL=
